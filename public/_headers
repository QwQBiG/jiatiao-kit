/wec-counselor-leave-apps/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow, noarchive
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/wec-counselor-leave-apps/leave/share/
  Cache-Control: private, no-store, max-age=0
  Pragma: no-cache
  Expires: 0

/wec-counselor-leave-apps/leave/share/index
  Cache-Control: private, no-store, max-age=0
  Pragma: no-cache
  Expires: 0

/wec-counselor-leave-apps/leave/share/index.html
  Cache-Control: private, no-store, max-age=0
  Pragma: no-cache
  Expires: 0

# The script query version and asset filenames are content fingerprints.
/wec-counselor-leave-apps/leave/share/app.js
  Cache-Control: public, max-age=31536000, immutable

/share-card/share.js
  Cache-Control: no-store, max-age=0

/share-card/assets/leave-calendar-a3e862826a10.png
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/admin/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data: blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow, noarchive
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Page/code rules do not overlap the fingerprinted image rules.
/admin/
  Cache-Control: private, no-store, max-age=0

/admin/:file
  Cache-Control: private, no-store, max-age=0

/local-theme/*
  Cache-Control: private, no-store
  X-Content-Type-Options: nosniff

/theme-placeholder/*
  Cache-Control: no-store
